# Firebase web app config.
#
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup
# and configuration → Config. Copy this file to `.env` and paste the values in.
#
# These are PUBLIC by design — they ship in the client bundle and identify your
# project, they do not authorise anything. Access control lives in
# firestore.rules. Do not put secrets here.

PUBLIC_FIREBASE_API_KEY=""
PUBLIC_FIREBASE_AUTH_DOMAIN=""
PUBLIC_FIREBASE_PROJECT_ID=""
PUBLIC_FIREBASE_STORAGE_BUCKET=""
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
PUBLIC_FIREBASE_APP_ID=""

# Set to "true" to point the app at the local Firebase emulators
# (`npm run emulators`) instead of your real project.
PUBLIC_USE_FIREBASE_EMULATORS="false"
